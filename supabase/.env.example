# Secrets for Supabase Edge Functions — never referenced by the mobile app.
#
# Local dev:  supabase functions serve --env-file supabase/.env
# Deployed:   supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the
# Supabase runtime in both cases — do not set them here.

# OpenAI — used for Whisper transcription (transcribe-audio, search-notes)
# and for text-embedding-3-small (structure-transcript, search-notes).
WHISPER_API_KEY=

# Anthropic — used for structuring (structure-transcript).
ANTHROPIC_API_KEY=

# Optional override, defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=
