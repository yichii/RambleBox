# Public — safe to bundle in the mobile app. Expo inlines EXPO_PUBLIC_*
# vars at build time. Do NOT put WHISPER_API_KEY or ANTHROPIC_API_KEY here
# or in any mobile-side env file — those live in supabase/.env (Edge
# Function secrets) and are never sent to the client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
